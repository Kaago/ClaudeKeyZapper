{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyZapper",
  "mainBinaryName": "KeyZapper",
  "version": "1.1.0",
  "identifier": "io.github.bl0rb.keyzapper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "KeyZapper",
        "width": 1040,
        "height": 740,
        "minWidth": 860,
        "minHeight": 520,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "usage",
        "url": "usage.html",
        "title": "KeyZapper",
        "width": 340,
        "height": 320,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2026 bl0rb · MIT License · github.com/bl0rb/ClaudeKeyZapper",
    "shortDescription": "Project-specific LiteLLM keys for Claude Code",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
