Windows Registry Editor Version 5.00

; KeyZapper for Windows reads the same settings as the macOS preference file, from
; HKLM\SOFTWARE\Policies\KeyZapper (machine, wins) or HKCU\SOFTWARE\Policies\KeyZapper.
; Strings: REG_SZ, lists: REG_MULTI_SZ, switches: REG_DWORD 0/1, ManagedProfiles: JSON array as REG_SZ.
; Claude in Microsoft 365 and Claude Desktop's own SSO sign-in: the optional "Office" and "ClaudeDesktop" objects inside a
; ManagedProfiles entry (see the SSO profile below).
; ClaudeDesktop also takes CredentialKind: "external-idp" (default, Claude Desktop 2.7032.0 or newer) or "interactive" (older versions).

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\KeyZapper]
"ManagedProfiles"="[{\"Name\":\"Projekt Alpha\",\"Endpoint\":\"https://litellm.firma.example\",\"OpusModel\":\"eu.anthropic.claude-opus-5-team\",\"SonnetModel\":\"eu.anthropic.claude-sonnet-5-team\",\"HaikuModel\":\"eu.anthropic.claude-haiku-4-5\",\"Environment\":{\"CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS\":\"1\"}},{\"Name\":\"SSO Projekt\",\"Type\":\"oidc\",\"Endpoint\":\"https://litellm.firma.example\",\"OIDCIssuer\":\"https://login.firma.example/t/v2.0\",\"OIDCClientID\":\"c1abe1234567890abcdef\",\"OIDCScope\":\"api://c1abe1234567890abcdef/.default offline_access\",\"Environment\":{\"CLAUDE_CODE_API_KEY_HELPER_TTL_MS\":\"900000\"},\"ClaudeDesktop\":{\"GatewayURL\":\"https://litellm.firma.example/api/x/desktop-gateway/desktop\",\"OIDCIssuer\":\"https://login.microsoftonline.com/00000000-0000-4000-8000-000000000000/v2.0\",\"OIDCClientID\":\"22222222-3333-4444-8555-666666666666\"},\"Office\":{\"Enabled\":true,\"AddinID\":\"5c1d7e2a-8b3f-4e6d-9a0c-2f4b6d8e1a3c\",\"GatewayURL\":\"https://litellm.firma.example/api/x/desktop-gateway/office\",\"EntraClientID\":\"11111111-2222-4333-8444-555555555555\",\"EntraScope\":\"api://11111111-2222-4333-8444-555555555555/access_as_user\",\"DisabledFeatures\":[\"web_search\"]}}]"
; AllowedGatewayHosts as REG_MULTI_SZ: litellm.firma.example, *.litellm.firma.example
"AllowedGatewayHosts"=hex(7):6c,00,69,00,74,00,65,00,6c,00,6c,00,6d,00,2e,00,66,00,69,00,72,00,6d,00,61,00,\
  2e,00,65,00,78,00,61,00,6d,00,70,00,6c,00,65,00,00,00,2a,00,2e,00,6c,00,69,00,74,00,65,00,6c,00,6c,00,6d,\
  00,2e,00,66,00,69,00,72,00,6d,00,61,00,2e,00,65,00,78,00,61,00,6d,00,70,00,6c,00,65,00,00,00,00,00
"DefaultEndpoint"="https://litellm.firma.example"
"DefaultModelAlias"="claude-sonnet"
"MinimumClaudeCodeVersion"="2.1.288"
"OneDriveBackup"=dword:00000001
"UpdateCheckEnabled"=dword:00000000
"AllowKeyExport"=dword:00000001
"ManagedMcpServersURL"="https://sso.firma.example/keyzapper/mcp-servers.json"
"ClaudeToolsEnabled"=dword:00000001
